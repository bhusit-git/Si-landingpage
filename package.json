{
  "name": "super-ice-group-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "npm run check && astro build && node scripts/validate-build.mjs",
    "preview": "astro preview",
    "validate": "node scripts/validate-build.mjs",
    "verify:production": "node scripts/verify-production-config.mjs",
    "preview:worker": "npm run build && wrangler dev",
    "deploy:worker": "npm run verify:production && npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/kanit": "5.3.0",
    "astro": "7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3",
    "wrangler": "4.124.0"
  }
}
