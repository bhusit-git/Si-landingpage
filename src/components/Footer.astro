---
import SiteMark from "./SiteMark.astro";
import ContactActions from "./ContactActions.astro";
import site from "../config/site.js";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__intro">
      <a href="/th/" aria-label="Super Ice Group หน้าแรก"><SiteMark inverse /></a>
      <p>
        {site.company.legalName}<br />{site.company.address}
      </p>
      <ContactActions compact onDark />
    </div>

    <div class="site-footer__links">
      <div class="site-footer__group">
        <h2>แบรนด์และสินค้า</h2>
        <ul>
          <li><a href="/th/products/">ผลิตภัณฑ์ทั้งหมด</a></li>
          <li><a href="/th/super-ice/">Super Ice</a></li>
          <li><a href="/th/iceberg/">ICEBERG</a></li>
        </ul>
      </div>

      <div class="site-footer__group">
        <h2>บริการและหลักฐาน</h2>
        <ul>
          <li><a href="/th/services/ice-delivery/">บริการจัดส่งน้ำแข็ง</a></li>
          <li><a href="/th/delivery-areas/">พื้นที่จัดส่ง</a></li>
          <li><a href="/th/quality-and-standards/">คุณภาพและมาตรฐาน</a></li>
          <li><a href="/th/production-process/">กระบวนการผลิต</a></li>
          <li><a href="/th/sustainability/">ความยั่งยืน</a></li>
        </ul>
      </div>

      <div class="site-footer__group">
        <h2>บริษัท</h2>
        <ul>
          <li><a href="/th/about/">เกี่ยวกับเรา</a></li>
          <li><a href="/th/contact/">ติดต่อ</a></li>
          <li><a href="/th/request-a-quote/">ขอใบเสนอราคา</a></li>
          <li><a href="/th/privacy-notice/">ประกาศความเป็นส่วนตัว</a></li>
          <li><a href="/th/cookie-policy/">นโยบายคุกกี้</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="container site-footer__bottom">
    <span>© {year} Super Ice Group</span>
    <span>เว็บไซต์ภาษาไทย</span>
  </div>
</footer>
