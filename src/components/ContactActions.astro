---
import site, { hasLine } from "../config/site.js";

interface Props {
  compact?: boolean;
  onDark?: boolean;
  availableOnly?: boolean;
}

const { compact = false, onDark = false, availableOnly = false } = Astro.props;

const actions = [
  {
    key: "line",
    label: hasLine ? "LINE" : "LINE",
    href: hasLine ? site.contact.line : "/th/contact/#line",
    event: hasLine ? "click_line" : undefined,
    available: hasLine,
  },
];
const visibleActions = actions.filter((action) => action.available);
---

<div class:list={["contact-actions", { compact, "on-dark": onDark }]}>
  {
    visibleActions.map((action) => (
      <a href={action.href} data-track={action.event} data-channel={action.key}>
        <span class="contact-actions__icon" aria-hidden="true">
          <i class="ph ph-chat-circle-dots" />
        </span>
        <span>{action.label}</span>
      </a>
    ))
  }
  {
    !availableOnly && visibleActions.length === 0 && (
      <p class="contact-actions__pending">
        ช่องทางติดต่ออยู่ระหว่างยืนยันข้อมูล
      </p>
    )
  }
</div>
