---
import site, { hasEmail, hasLine, hasPhone } from "../config/site.js";

interface Props {
  compact?: boolean;
  onDark?: boolean;
  availableOnly?: boolean;
}

const { compact = false, onDark = false, availableOnly = false } = Astro.props;

const actions = [
  {
    key: "phone",
    label: hasPhone ? site.contact.phoneDisplay : "โทร",
    href: hasPhone ? `tel:${site.contact.phone}` : "/th/contact/#phone",
    event: hasPhone ? "click_phone" : undefined,
    available: hasPhone,
  },
  {
    key: "line",
    label: hasLine ? "LINE" : "LINE",
    href: hasLine ? site.contact.line : "/th/contact/#line",
    event: hasLine ? "click_line" : undefined,
    available: hasLine,
  },
  {
    key: "email",
    label: hasEmail ? "อีเมล" : "อีเมล",
    href: hasEmail
      ? `mailto:${site.contact.email}?subject=${encodeURIComponent("สอบถามบริการน้ำแข็ง")}`
      : "/th/contact/#email",
    event: hasEmail ? "click_email" : undefined,
    available: hasEmail,
  },
];
const visibleActions = actions.filter((action) => action.available);
---

<div class:list={["contact-actions", { compact, "on-dark": onDark }]}>
  {
    visibleActions.map((action) => (
      <a href={action.href} data-track={action.event} data-channel={action.key}>
        <span class="contact-actions__icon" aria-hidden="true">
          {action.key === "phone" ? "T" : action.key === "line" ? "L" : "E"}
        </span>
        <span>{action.label}</span>
      </a>
    ))
  }
  {
    !availableOnly && visibleActions.length === 0 && (
      <p class="contact-actions__pending">
        โทรศัพท์ LINE และอีเมลอยู่ระหว่างยืนยันข้อมูล
      </p>
    )
  }
</div>
