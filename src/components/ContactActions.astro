---
import site, { hasEmail, hasLine, hasPhone } from "../config/site.js";

interface Props {
  compact?: boolean;
  onDark?: boolean;
  availableOnly?: boolean;
}

const { compact = false, onDark = false, availableOnly = false } = Astro.props;

const actions = [
  {
    key: "phone",
    label: "โทรศัพท์",
    href: hasPhone ? `tel:${site.contact.phone.replace(/\s/g, "")}` : undefined,
    event: hasPhone ? "click_phone" : undefined,
    available: hasPhone,
    icon: "ph-phone",
  },
  {
    key: "email",
    label: "อีเมล",
    href: hasEmail ? `mailto:${site.contact.email}` : undefined,
    event: hasEmail ? "click_email" : undefined,
    available: hasEmail,
    icon: "ph-envelope-simple",
  },
  {
    key: "line",
    label: "LINE",
    href: hasLine ? site.contact.line : undefined,
    event: hasLine ? "click_line" : undefined,
    available: hasLine,
    icon: "ph-chat-circle-dots",
  },
];
const visibleActions = availableOnly
  ? actions.filter((action) => action.available)
  : actions.filter((action) => action.key !== "line" || action.available);
---

<div class:list={["contact-actions", { compact, "on-dark": onDark }]}>
  {
    visibleActions.map((action) =>
      action.available ? (
        <a
          class="contact-actions__item"
          href={action.href}
          data-track={action.event}
          data-channel={action.key}
        >
          <span class="contact-actions__icon" aria-hidden="true">
            <i class:list={["ph", action.icon]} />
          </span>
          <span>{action.label}</span>
        </a>
      ) : (
        <span
          class="contact-actions__item contact-actions__item--pending"
          aria-label={`${action.label} รอยืนยันข้อมูล`}
        >
          <span class="contact-actions__icon" aria-hidden="true">
            <i class:list={["ph", action.icon]} />
          </span>
          <span>{action.label}</span>
          <small>รอยืนยันข้อมูล</small>
        </span>
      )
    )
  }
  {
    !availableOnly && visibleActions.length === 0 && (
      <p class="contact-actions__pending">
        ช่องทางติดต่ออยู่ระหว่างยืนยันข้อมูล
      </p>
    )
  }
</div>
