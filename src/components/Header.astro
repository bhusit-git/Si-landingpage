---
import SiteMark from "./SiteMark.astro";
import site from "../config/site.js";

const productNavItems = [
  { href: "/th/products/", label: "ผลิตภัณฑ์ทั้งหมด" },
  { href: "/th/super-ice/", label: "Super Ice" },
  { href: "/th/iceberg/", label: "ICEBERG" },
];

const navItems = [
  { href: "/th/services/ice-delivery/", label: "การจัดส่ง" },
  { href: "/th/quality-and-standards/", label: "คุณภาพ" },
  { href: "/th/about/", label: "เกี่ยวกับเรา" },
];

const pathname = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/th/" ? pathname === href : pathname.startsWith(href);
const isProductCurrent = productNavItems.some((item) => isCurrent(item.href));
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/th/" aria-label="Super Ice Group หน้าแรก">
      <SiteMark />
    </a>

    <nav class="desktop-nav" aria-label="เมนูหลัก">
      <details class="nav-dropdown">
        <summary aria-current={isProductCurrent ? "page" : undefined}>
          ผลิตภัณฑ์
          <span class="nav-dropdown__icon" aria-hidden="true"></span>
        </summary>
        <div class="nav-dropdown__menu">
          {
            productNavItems.map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </div>
      </details>
      {
        navItems.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      class="button button--small site-header__cta"
      href={site.brandContacts.iceberg.lineUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-track="click_line"
      data-channel="header-line"
    >
      สั่งได้ทาง LINE
    </a>

    <details class="mobile-nav">
      <summary aria-label="เมนูหลัก">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </summary>
      <nav aria-label="เมนูหลักบนมือถือ">
        <details class="mobile-nav__group" open={isProductCurrent}>
          <summary>
            ผลิตภัณฑ์
            <span class="nav-dropdown__icon" aria-hidden="true"></span>
          </summary>
          <div>
            {
              productNavItems.map((item) => (
                <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              ))
            }
          </div>
        </details>
        {
          navItems.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
        <a
          class="button"
          href={site.brandContacts.iceberg.lineUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-track="click_line"
          data-channel="mobile-menu-line"
        >สั่งได้ทาง LINE</a>
      </nav>
    </details>
  </div>
</header>
