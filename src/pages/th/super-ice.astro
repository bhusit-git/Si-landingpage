---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PageHero from "../../components/PageHero.astro";
import ProductVisual from "../../components/ProductVisual.astro";
import ContactActions from "../../components/ContactActions.astro";
import site from "../../config/site.js";
import { brandSchema, breadcrumbSchema, organizationSchema, webPageSchema } from "../../lib/seo";

const title = "Super Ice น้ำแข็งสะอาด มาตรฐานที่ทุกธุรกิจไว้วางใจ";
const description =
  "Super Ice ไลน์ผลิตภัณฑ์น้ำแข็งมาตรฐานสำหรับธุรกิจ รองรับการใช้งานปริมาณมาก มั่นใจในสุขอนามัยและระบบการจัดส่งที่สม่ำเสมอ";
const path = "/th/super-ice/";
const breadcrumbs = [
  { label: "หน้าแรก", href: "/th/" },
  { label: "Super Ice", href: path },
];
const productOrder = [
  "small-tube-ice",
  "large-tube-ice",
  "block-ice",
  "crushed-ice",
  "clear-bag-packed-ice",
];
const getOrder = (id: string) => {
  const idx = productOrder.indexOf(id);
  return idx === -1 ? 99 : idx;
};

const rawProducts = await getCollection(
  "products",
  ({ data }) =>
    data.brand === "Super Ice" && !data.draft && (!site.productionReady || data.copyApproved),
);
const products = rawProducts.sort((a, b) => getOrder(a.id) - getOrder(b.id));
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  schemas={[
    organizationSchema(),
    brandSchema({ name: "Super Ice", description, path }),
    webPageSchema({ title, description, path }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <Breadcrumbs items={breadcrumbs} />
  <PageHero
    eyebrow="SUPER ICE / STANDARD RANGE"
    title="Super Ice น้ำแข็งสะอาด มาตรฐานที่ทุกธุรกิจไว้วางใจ"
    lead="ไลน์ผลิตภัณฑ์น้ำแข็งมาตรฐานสำหรับธุรกิจ รองรับการใช้งานปริมาณมากในชีวิตประจำวัน มั่นใจได้ในสุขอนามัยและระบบการจัดส่งที่สม่ำเสมอ"
    brand="Super Ice"
  />

  <section class="section brand-story">
    <div class="container brand-story__grid">
      <div data-reveal>
        <div class="brand-badge-row">
          <img src="/images/logo/super-ice-logo.png" alt="Super Ice Logo" class="brand-hero-logo" width="72" height="54" />
          <div>
            <p class="eyebrow" lang="en" style="margin-bottom: 0;">HIGH-CAPACITY & HYGIENIC</p>
            <span style="font-size: 0.85rem; color: var(--color-ice-action); font-weight: 600; letter-spacing: 0.05em;">SUPER ICE OFFICIAL BRAND</span>
          </div>
        </div>
        <h2>สะอาด ได้มาตรฐาน คุ้มค่า ตอบโจทย์การใช้งานจริง</h2>
        <p class="lead">Super Ice ออกแบบมาเพื่อรองรับการใช้งานทั่วไปในธุรกิจทุกระดับ ด้วยกำลังผลิตรวมกว่า 5,000 ตัน/วัน และระบบกรองน้ำ Reverse Osmosis (RO) บริสุทธิ์</p>
        <p>พร้อมกองรถควบคุมอุณหภูมิหลายขนาดสำหรับรอบส่งประจำ ยินดีให้คำปรึกษาและประเมินราคา ค่าจัดส่ง รวมถึงรอบส่งมอบตามพื้นที่และความต้องการจริงของแต่ละธุรกิจตลอด 24 ชั่วโมง</p>
      </div>
      <figure class="brand-delivery-photo" data-reveal>
        <img
          src="/images/delivery/super-ice-delivery-fleet.webp"
          alt="กองรถห้องเย็น Super Ice จอดพร้อมสำหรับรอบจัดส่ง"
          width="1600"
          height="819"
          loading="lazy"
          decoding="async"
        />
        <figcaption>พร้อมจัดส่งน้ำแข็งสำหรับธุรกิจตามรอบที่วางแผนร่วมกัน</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--surface product-family">
    <div class="container product-family__heading" data-reveal>
      <div>
        <p class="eyebrow" lang="en">PRODUCT</p>
        <h2>ผลิตภัณฑ์น้ำแข็งมาตรฐาน Super Ice</h2>
      </div>
    </div>
    <div class:list={["container", "product-listing", { "product-listing--single": products.length === 1 }]}>
      {
        products.map((product) => (
          <article class="product-card" data-reveal>
            <ProductVisual kind={product.id} label={product.data.title} />
            <div class="product-card__copy">
              <p class="eyebrow" lang="en">{product.data.brand}</p>
              <h3>{product.data.title}</h3>
              <p>{product.data.summary}</p>
              <a class="text-link" href={`/th/products/${product.id}/`}>ดูรายละเอียดสินค้า</a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section final-cta">
    <div class="container final-cta__grid">
      <div><p class="eyebrow" lang="en">SUPER ICE ENQUIRY</p><h2>สอบถามข้อมูลน้ำแข็งสำหรับธุรกิจ</h2><p>ปรึกษาทีมงานเพื่อรับคำแนะนำเรื่องชนิดน้ำแข็ง การจัดส่ง และใบเสนอราคาพิเศษสำหรับธุรกิจคุณ</p></div>
      <div class="final-cta__actions"><a class="button" href="/th/request-a-quote/">ขอใบเสนอราคา</a><ContactActions compact /></div>
    </div>
  </section>
</BaseLayout>
