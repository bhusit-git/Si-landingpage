---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ContactActions from "../../components/ContactActions.astro";
import site from "../../config/site.js";
import {
  breadcrumbSchema,
  organizationSchema,
  webPageSchema,
  websiteSchema,
} from "../../lib/seo";

const title = "ผู้ผลิตและจัดส่งน้ำแข็งสำหรับธุรกิจ | Super Ice Group";
const description =
  "Super Ice Group เชื่อมการผลิต การควบคุมคุณภาพ การจัดเก็บ และการจัดส่ง พร้อม Super Ice สำหรับน้ำแข็งทั่วไป และ ICEBERG สำหรับน้ำแข็งพรีเมียม";
const path = "/th/";
const breadcrumbs = [{ label: "หน้าแรก", href: path }];
const companyFacts = site.reviewFacts;
const solutions = (await getCollection("solutions", ({ data }) => !data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, "th"),
);

const process = [
  ["01", "เตรียมน้ำ", "อธิบายแหล่งน้ำและระบบกรองจากข้อมูลที่ผ่านการตรวจสอบ"],
  ["02", "ผลิต", "ควบคุมเครื่องจักรและกระบวนการให้สอดคล้องกับชนิดสินค้า"],
  ["03", "บรรจุ", "จัดการบรรจุภัณฑ์และข้อมูลกำกับสินค้าอย่างเป็นระบบ"],
  ["04", "จัดเก็บ", "รักษาสภาพสินค้าก่อนออกจากจุดกระจายสินค้า"],
  ["05", "ประสานการส่ง", "ประเมินสินค้า ปริมาณ และพื้นที่ก่อนยืนยันรายละเอียด"],
];

const faq = [
  {
    question: "Super Ice Group, Super Ice และ ICEBERG ต่างกันอย่างไร?",
    answer:
      "Super Ice Group คือบริษัทแม่และเว็บไซต์หลัก, Super Ice คือแบรนด์น้ำแข็งทั่วไป และ ICEBERG คือแบรนด์น้ำแข็งพรีเมียมภายในกลุ่ม",
  },
  {
    question: "เว็บไซต์แสดงราคาและค่าจัดส่งหรือไม่?",
    answer:
      "ไม่แสดงราคา ค่าจัดส่ง หรือรอบจัดส่งแบบเหมารวม กรุณาแจ้งชนิดสินค้า ปริมาณ และพื้นที่เพื่อให้ทีมงานประเมินตามงานจริง",
  },
  {
    question: "ควรเตรียมข้อมูลอะไรเมื่อติดต่อ?",
    answer:
      "เตรียมประเภทธุรกิจ พื้นที่หรือรหัสไปรษณีย์ ชนิดน้ำแข็ง ปริมาณโดยประมาณ และวันที่หรือความถี่ที่ต้องการ",
  },
  {
    question: "มีเอกสารมาตรฐานให้ตรวจสอบหรือไม่?",
    answer:
      "หน้าเว็บเตรียมโครงสำหรับเอกสารและข้อมูลคุณภาพ แต่จะแสดงเฉพาะฉบับที่ตรวจวันหมดอายุ ความครบถ้วน และสิทธิ์เผยแพร่แล้วเท่านั้น",
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  schemas={[
    organizationSchema(),
    websiteSchema(),
    webPageSchema({ title, description, path }),
    breadcrumbSchema(breadcrumbs),
  ]}
  bodyClass="home-page"
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="home-hero">
    <div class="container home-hero__grid">
      <div class="home-hero__copy" data-reveal>
        <p class="eyebrow" lang="en">SUPER ICE GROUP</p>
        <h1>พันธมิตรด้านน้ำแข็งสำหรับธุรกิจ ตั้งแต่การผลิตถึงการจัดส่ง</h1>
        <p class="lead">
          โครงสร้างบริการที่แยกชัดเจนระหว่าง <strong>Super Ice</strong> สำหรับน้ำแข็งทั่วไป
          และ <strong>ICEBERG</strong> สำหรับน้ำแข็งพรีเมียม พร้อมข้อมูลช่วยเลือกสินค้าและเตรียมการติดต่อ
        </p>
        <div class="hero-actions">
          <a class="button" href="/th/request-a-quote/">ขอใบเสนอราคา</a>
          <a class="button button--secondary" href="/th/products/">ดูผลิตภัณฑ์</a>
        </div>
      </div>

      <div class="home-hero__visual" aria-hidden="true">
        <span class="hero-visual__label">SYSTEM / PRODUCT / SERVICE</span>
        <span class="hero-cube hero-cube--large"><i></i></span>
        <span class="hero-cube hero-cube--medium"><i></i></span>
        <span class="hero-cube hero-cube--small"><i></i></span>
        <span class="hero-visual__dots"><i></i><i></i><i></i></span>
        <span class="hero-visual__caption">PRODUCTION / QUALITY / DELIVERY</span>
      </div>
    </div>
  </section>

  <section class="proof-rail" aria-label="ข้อมูลสำคัญของ Super Ice Group">
    <div class="container proof-rail__grid">
      {
        companyFacts.map((fact) => (
          <div>
            <strong>{fact.value}</strong>
            <span>{fact.label}<small>{fact.scope}</small></span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section brand-section" id="brands">
    <div class="container section-heading" data-reveal>
      <div>
        <p class="eyebrow" lang="en">TWO DISTINCT BRANDS</p>
        <h2>เลือกแบรนด์ตามรูปแบบการใช้งาน</h2>
      </div>
      <p>ทุกจุดบนเว็บไซต์ระบุชื่อแบรนด์ให้ชัด เพื่อไม่ให้ข้อมูลบริษัทแม่ สินค้าทั่วไป และสินค้าพรีเมียมปะปนกัน</p>
    </div>

    <div class="container brand-selector">
      <article class="brand-panel brand-panel--standard" data-reveal>
        <span class="brand-panel__number">01</span>
        <p class="eyebrow" lang="en">STANDARD / EVERYDAY</p>
        <h3>Super Ice</h3>
        <p>น้ำแข็งทั่วไปสำหรับการใช้งานประจำและงานที่ต้องพิจารณาปริมาณอย่างเป็นระบบ</p>
        <a class="text-link" href="/th/super-ice/">ดูแบรนด์ Super Ice</a>
        <div class="brand-panel__shape" aria-hidden="true"></div>
      </article>

      <article class="brand-panel brand-panel--premium" data-reveal>
        <span class="brand-panel__number">02</span>
        <p class="eyebrow" lang="en">PREMIUM / HOSPITALITY</p>
        <h3>ICEBERG</h3>
        <p>น้ำแข็งพรีเมียมรูปทรงต่าง ๆ สำหรับเครื่องดื่ม ร้านอาหาร คาเฟ่ บาร์ และ hospitality</p>
        <a class="text-link" href="/th/iceberg/">ดูแบรนด์ ICEBERG</a>
        <div class="brand-panel__shape" aria-hidden="true"></div>
      </article>
    </div>
  </section>

  <section class="section section--surface" id="solutions">
    <div class="container section-heading" data-reveal>
      <div>
        <p class="eyebrow" lang="en">SOLUTIONS BY BUSINESS</p>
        <h2>เริ่มจากโจทย์ของธุรกิจคุณ</h2>
      </div>
      <p>เลือกตามประเภทการใช้งาน แล้วเชื่อมต่อไปยังสินค้า คุณภาพ พื้นที่ และขั้นตอนการสอบถามที่เกี่ยวข้อง</p>
    </div>

    <div class="container solution-list">
      {
        solutions.map((solution, index) => (
          <a href={`/th/solutions/${solution.id}/`} data-reveal>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{solution.data.title}</strong>
            <small>{solution.data.description}</small>
            <i aria-hidden="true">→</i>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section process-section">
    <div class="container section-heading" data-reveal>
      <div>
        <p class="eyebrow" lang="en">FROM SOURCE TO SERVICE</p>
        <h2>กระบวนการที่อธิบายได้ทุกช่วง</h2>
      </div>
      <a class="text-link" href="/th/production-process/">ดูกระบวนการผลิต</a>
    </div>

    <ol class="container process-steps">
      {
        process.map(([number, name, detail]) => (
          <li data-reveal>
            <span>{number}</span>
            <h3>{name}</h3>
            <p>{detail}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section section--dark quality-feature">
    <div class="container quality-feature__grid">
      <div data-reveal>
        <p class="eyebrow" lang="en">QUALITY INFORMATION</p>
        <h2>หลักฐานต้องอ่านได้ ตรวจสอบได้ และเป็นฉบับปัจจุบัน</h2>
        <p class="lead">
          หน้าเอกสารออกแบบให้แสดงชื่อผู้ออก เลขที่ วันที่ และสถานะเป็น HTML
          โดยจะไม่เผยแพร่สแกน ผลตรวจ หรือใบรับรองจนกว่าสิทธิ์และอายุเอกสารจะผ่านการยืนยัน
        </p>
        <a class="button button--on-dark" href="/th/quality-and-standards/">ดูแนวทางคุณภาพ</a>
      </div>
      <div class="quality-register" aria-label="หลักการตรวจเอกสาร" data-reveal>
        <div><span>01</span><strong>ตรวจแหล่งที่มา</strong></div>
        <div><span>02</span><strong>ตรวจวันมีผล</strong></div>
        <div><span>03</span><strong>ตรวจสิทธิ์เผยแพร่</strong></div>
        <div><span>04</span><strong>สรุปเป็นข้อมูล HTML</strong></div>
      </div>
    </div>
  </section>

  <section class="section delivery-feature">
    <div class="container delivery-feature__grid">
      <div class="delivery-map" aria-hidden="true" data-reveal>
        <span class="delivery-map__zone zone-a"></span>
        <span class="delivery-map__zone zone-b"></span>
        <span class="delivery-map__zone zone-c"></span>
        <span class="delivery-map__route"></span>
        <strong>AREA REVIEW</strong>
        <small>ยืนยันพื้นที่ก่อนเสนอรายละเอียด</small>
      </div>
      <div data-reveal>
        <p class="eyebrow" lang="en">DELIVERY COORDINATION</p>
        <h2>เช็กพื้นที่และเงื่อนไขก่อนยืนยันบริการ</h2>
        <p class="lead">
          แจ้งพื้นที่หรือรหัสไปรษณีย์ ชนิดสินค้า ปริมาณ และวันที่ต้องการ
          เพื่อให้ทีมงานตรวจสอบความเหมาะสมโดยไม่เผยแพร่ค่าส่งหรือรอบส่งแบบเหมารวม
        </p>
        <a class="button" href="/th/delivery-areas/" data-track="check_delivery_area">เช็กพื้นที่จัดส่ง</a>
      </div>
    </div>
  </section>

  <section class="section section--surface sustainability-teaser">
    <div class="container sustainability-teaser__grid" data-reveal>
      <div>
        <p class="eyebrow" lang="en">RESPONSIBLE OPERATIONS</p>
        <h2>บันทึกสิ่งที่ทำ และแยกข้อเท็จจริงออกจากเป้าหมาย</h2>
      </div>
      <p>
        ข้อมูลด้านพลังงานแสงอาทิตย์ การติดตามบรรจุภัณฑ์ และการรับคืนเพื่อรีไซเคิล
        จะสื่อสารเมื่อมีขอบเขต ช่วงเวลา และหลักฐานที่ตรวจสอบได้ครบถ้วน
      </p>
      <a class="text-link" href="/th/sustainability/">ดูแนวทางความยั่งยืน</a>
    </div>
  </section>

  <section class="section faq-section">
    <div class="container faq-section__grid">
      <div data-reveal>
        <p class="eyebrow" lang="en">FAQ</p>
        <h2>คำตอบก่อนเริ่มคุยกับทีมงาน</h2>
      </div>
      <div class="faq-list">
        {
          faq.map((item) => (
            <details data-reveal>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container final-cta__grid">
      <div data-reveal>
        <p class="eyebrow" lang="en">START A CONVERSATION</p>
        <h2>เตรียมข้อมูลให้พร้อม แล้วเลือกช่องทางที่สะดวก</h2>
        <p>ระบุประเภทธุรกิจ พื้นที่ ชนิดน้ำแข็ง ปริมาณโดยประมาณ และวันที่หรือความถี่ที่ต้องการ</p>
      </div>
      <div class="final-cta__actions" data-reveal>
        <a class="button" href="/th/request-a-quote/">ดูวิธีขอใบเสนอราคา</a>
        <ContactActions compact />
      </div>
    </div>
  </section>
</BaseLayout>
