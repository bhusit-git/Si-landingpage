---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ContactActions from "../../components/ContactActions.astro";
import SiteMark from "../../components/SiteMark.astro";
import site from "../../config/site.js";
import {
  breadcrumbSchema,
  organizationSchema,
  webPageSchema,
  websiteSchema,
} from "../../lib/seo";

const title = "ผู้ผลิตและจัดส่งน้ำแข็งสำหรับธุรกิจ | Super Ice Group";
const description =
  "Super Ice Group ผู้ผลิตและจัดส่งน้ำแข็งมาตรฐานอุตสาหกรรมและน้ำแข็งพรีเมียม RO สำหรับธุรกิจ ร้านอาหาร คาเฟ่ และบาร์ในกรุงเทพฯ และปริมณฑล";
const path = "/th/";
const breadcrumbs = [{ label: "หน้าแรก", href: path }];
const companyFacts = site.reviewFacts;
const clientBrands = [
  { name: "7-Eleven", logo: "/images/clients/7-eleven.png" },
  { name: "Central", logo: "/images/clients/central.png" },
  { name: "Lotus's", logo: "/images/clients/lotuss.png" },
  { name: "Foodland", logo: "/images/clients/foodland.png" },
  { name: "Mega Bangna", logo: "/images/clients/mega-bangna.png" },
  { name: "CP All", logo: "/images/clients/cp-all.png" },
  { name: "Café Amazon", logo: "/images/clients/cafe-amazon.png" },
  { name: "Swensen's", logo: "/images/clients/swensens.png" },
  { name: "MK Restaurants", logo: "/images/clients/mk-restaurants.png" },
  { name: "Bar-B-Q Plaza", logo: "/images/clients/bar-b-q-plaza.png" },
  { name: "Eat Am Are", logo: "/images/clients/eat-am-are.png" },
  { name: "Greyhound Café", logo: "/images/clients/greyhound-cafe.png" },
  { name: "Sorn", logo: "/images/clients/sorn.png" },
  { name: "Potong", logo: "/images/clients/potong.png" },
];
const solutions = (await getCollection("solutions", ({ data }) => !data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, "th"),
);

const process = [
  { number: "01", icon: "ph-drop", name: "เตรียมน้ำบริสุทธิ์", detail: "กรองน้ำด้วยระบบ Reverse Osmosis (RO) มาตรฐานสูง สะอาด ปราศจากสิ่งเจือปน" },
  { number: "02", icon: "ph-snowflake", name: "ผลิตและแช่แข็งพิเศษ", detail: "ควบคุมความสะอาดทุกจุด ด้วยกระบวนการแช่แข็งช้าเพื่อความใสไร้ฟองอากาศ" },
  { number: "03", icon: "ph-package", name: "บรรจุภัณฑ์ปิดสนิท", detail: "บรรจุด้วยระบบกึ่งอัตโนมัติในถุงลามิเนตมาตรฐาน ป้องกันการปนเปื้อน 100%" },
  { number: "04", icon: "ph-thermometer-cold", name: "จัดเก็บในห้องเย็นลึก", detail: "ควบคุมอุณหภูมิติดลบสม่ำเสมอ เพื่อคงสภาพก้อนน้ำแข็งให้คมชัดและแห้งสนิท" },
  { number: "05", icon: "ph-truck", name: "จัดส่งควบคุมอุณหภูมิ 24/7", detail: "กระจายสินค้าด้วยรถห้องเย็นตลอด 24 ชั่วโมง ส่งตรงถึงหน้าร้านตามรอบเวลา" },
];

const processAssurances = [
  { icon: "ph-shield-check", title: "มาตรฐานระดับสากล", detail: "ควบคุมคุณภาพทุกขั้นตอน" },
  { icon: "ph-flask", title: "สะอาด ปลอดภัย", detail: "ผ่านการควบคุมด้านสุขอนามัย" },
  { icon: "ph-medal", title: "คุณภาพสม่ำเสมอ", detail: "มั่นใจได้ในทุกการใช้งาน" },
  { icon: "ph-headset", title: "บริการมืออาชีพ", detail: "ดูแลธุรกิจคุณทุกขั้นตอน" },
];

const faq = [
  {
    question: "Super Ice Group, Super Ice และ ICEBERG ต่างกันอย่างไร?",
    answer:
      "Super Ice Group คือบริษัทแม่และศูนย์รวมการผลิตและจัดส่ง, Super Ice คือแบรนด์น้ำแข็งคุณภาพมาตรฐานสำหรับการใช้งานทั่วไปและปริมาณมาก ส่วน ICEBERG คือแบรนด์น้ำแข็งพรีเมียมใสพิเศษ (Crystal Clear) รูปทรง Ball, Cube, Stick และ Shaker สำหรับเครื่องดื่มระดับคราฟต์",
  },
  {
    question: "เว็บไซต์แสดงราคาและค่าจัดส่งหรือไม่?",
    answer:
      "เนื่องจากราคาและค่าจัดส่งขึ้นอยู่กับชนิดสินค้า ปริมาณต่อรอบ และระยะทางจัดส่ง ทีมงานยินดีให้คำปรึกษาและประเมินราคาที่คุ้มค่าที่สุดสำหรับธุรกิจของคุณ พร้อมเงื่อนไขพิเศษสำหรับลูกค้ารายสัปดาห์หรือรายเดือน",
  },
  {
    question: "ควรเตรียมข้อมูลอะไรเมื่อติดต่อขอใบเสนอราคา?",
    answer:
      "เตรียมประเภทธุรกิจ (เช่น คาเฟ่ ค็อกเทลบาร์ ร้านอาหาร), พื้นที่จัดส่ง (เขต/อำเภอ), ชนิดน้ำแข็งที่สนใจ, ปริมาณโดยประมาณต่อวัน/สัปดาห์ และวันที่ต้องการเริ่มใช้บริการ",
  },
  {
    question: "มีเอกสารรับรองมาตรฐาน อย. และ GMP ให้ตรวจสอบหรือไม่?",
    answer:
      "เรามีใบอนุญาตผลิตอาหารจาก อย. (เลขที่ 10-1-16557) และใบรับรองมาตรฐาน GMP 420 จากสถาบันวิจัยวิทยาศาสตร์และเทคโนโลยีแห่งประเทศไทย (วว.) พร้อมเอกสารผลตรวจวิเคราะห์คุณภาพน้ำและน้ำแข็งสำหรับลูกค้าธุรกิจ",
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  schemas={[
    organizationSchema(),
    websiteSchema(),
    webPageSchema({ title, description, path }),
    breadcrumbSchema(breadcrumbs),
  ]}
  bodyClass="home-page"
>
  <Breadcrumbs items={breadcrumbs} />

  <!-- HERO SECTION -->
  <section class="home-hero">
    <div class="container home-hero__grid">
      <div class="home-hero__copy" data-reveal>
        <p class="eyebrow" lang="en">SUPER ICE GROUP • PRECISION IN EVERY CUBE</p>
        <h1>ยกระดับทุกแก้วและทุกธุรกิจ ด้วยน้ำแข็งมาตรฐานสากล</h1>
        <p class="home-hero__lead">
          ผลิตและจัดส่งน้ำแข็งเกรดพรีเมียม ละลายช้า สะอาดบริสุทธิ์ รองรับตั้งแต่บาร์ระดับไฮเอนด์จนถึงภาคอุตสาหกรรม
        </p>

        <div class="hero-highlights">
          <div class="hero-highlight-item">
            <span>✓</span> มาตรฐาน อย. & GMP 420
          </div>
          <div class="hero-highlight-item">
            <span>✓</span> กำลังผลิต 5,000+ ตัน/วัน
          </div>
          <div class="hero-highlight-item">
            <span>✓</span> รถขนส่งควบคุมอุณหภูมิ 24/7
          </div>
        </div>

        <div class="hero-actions">
          <a class="button" href="/th/request-a-quote/">ขอใบเสนอราคาด่วน</a>
          <a class="button button--secondary" href="/th/products/">ดูแคตตาล็อกสินค้า</a>
        </div>
      </div>

      <div class="home-hero__visual" data-reveal>
        <img src="/images/iceberg-hero.jpg" alt="ICEBERG Crystal Clear Ice Ball in Whiskey Glass" class="hero-visual__img" />
        <div class="hero-visual__overlay"></div>
        <span class="hero-visual__badge">ICEBERG • 48H ZERO BUBBLE</span>
        <div class="hero-visual__floating-card">
          <div>
            <h4>Crystal Clear Ice Ball</h4>
            <p>ทรงกลมใสพิเศษ ละลายช้า ไม่ทำให้เครื่องดื่มเสียรสชาติ</p>
          </div>
          <span class="spec-pill">Ø 55 / 60 mm</span>
        </div>
      </div>
    </div>
  </section>

  <!-- PROOF RAIL -->
  <section class="proof-rail" aria-label="ข้อมูลสำคัญของ Super Ice Group">
    <div class="container proof-rail__grid">
      {
        companyFacts.map((fact) => (
          <div>
            <strong>{fact.value}</strong>
            <span>{fact.label}<small>{fact.scope}</small></span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CLIENT BRAND MARQUEE -->
  <section class="client-logos" aria-labelledby="client-logos-title">
    <div class="container client-logos__heading" data-reveal>
      <p class="eyebrow" lang="en">TRUSTED BY LEADING BRANDS</p>
      <h2 id="client-logos-title">ส่วนหนึ่งของแบรนด์ชั้นนำที่ไว้วางใจเรา</h2>
      <p>ตั้งแต่ร้านอาหารและคาเฟ่ ไปจนถึงธุรกิจค้าปลีกขนาดใหญ่</p>
    </div>

    <div
      class="client-marquee"
      data-client-marquee
      data-reveal
      tabindex="0"
      role="region"
      aria-label="รายชื่อแบรนด์ลูกค้าแบบเลื่อนได้"
    >
      <div class="client-marquee__track">
        {
          [true, false, true].map((duplicate) => (
            <div class="client-marquee__group" aria-hidden={duplicate ? "true" : undefined}>
              {clientBrands.map((brand) => (
                <figure class="client-logo-card">
                  <img
                    src={brand.logo}
                    alt={duplicate ? "" : brand.name}
                    width="140"
                    height="110"
                    loading={duplicate ? "lazy" : "eager"}
                    decoding="async"
                  />
                  <figcaption>{brand.name}</figcaption>
                </figure>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- DUAL BRAND SELECTOR -->
  <section class="section brand-section" id="brands">
    <div class="container section-heading" data-reveal>
      <div>
        <p class="eyebrow" lang="en">TWO DISTINCT BRANDS</p>
        <h2>เลือกแบรนด์ที่ตอบโจทย์รูปแบบธุรกิจของคุณ</h2>
      </div>
      <p>เราออกแบบแบรนด์และสายการผลิตที่แยกชัดเจน เพื่อส่งมอบน้ำแข็งที่เหมาะสมที่สุด ทั้งด้านต้นทุน ความคุ้มค่า และภาพลักษณ์ของร้าน</p>
    </div>

    <div class="container brand-selector">
      <!-- SUPER ICE -->
      <article class="brand-panel brand-panel--standard" data-reveal>
        <div>
          <div class="brand-panel__header">
            <span class="brand-panel__number">BRAND 01</span>
            <img class="brand-panel__logo" src="/images/logo/super-ice-logo.png" alt="Super Ice Logo" width="56" height="42" loading="lazy" />
          </div>
          <p class="eyebrow" lang="en">STANDARD & BULK SUPPLY</p>
          <h3>Super Ice</h3>
          <p>น้ำแข็งสะอาดคุณภาพมาตรฐาน รองรับการใช้งานประจำวันในปริมาณมาก คุ้มค่า คุมต้นทุนได้ดี พร้อมรอบจัดส่งที่สม่ำเสมอตรงเวลาทุกวัน</p>
          
          <div class="brand-features">
            <span class="brand-pill">✓ น้ำแข็งหลอดเล็ก</span>
            <span class="brand-pill">✓ น้ำแข็งหลอดใหญ่</span>
            <span class="brand-pill">✓ น้ำแข็งซอง (ก้อน)</span>
            <span class="brand-pill">✓ น้ำแข็งโม่</span>
            <span class="brand-pill">✓ น้ำแข็งแพ็คถุงใส</span>
          </div>
        </div>
        <a class="text-link" href="/th/super-ice/">ดูรายละเอียดแบรนด์ Super Ice</a>
      </article>

      <!-- ICEBERG -->
      <article class="brand-panel brand-panel--premium" data-reveal>
        <div>
          <span class="brand-panel__number">BRAND 02</span>
          <p class="eyebrow" lang="en">LUXURY & CRAFT COCKTAIL</p>
          <h3>ICEBERG</h3>
          <p>น้ำแข็งคริสตัลใสบริสุทธิ์ ไร้ฟองอากาศ ผ่านการแช่แข็งพิเศษนาน 48 ชั่วโมง ละลายช้าเป็นพิเศษ เพื่อยกระดับประสบการณ์เครื่องดื่มในแก้วของคุณ</p>
          
          <div class="brand-features">
            <span class="brand-pill">💎 Ice Ball & Cube</span>
            <span class="brand-pill">💎 Ice Stick & Shaker</span>
            <span class="brand-pill">💎 สำหรับ Cocktail & Bar</span>
          </div>
        </div>
        <a class="text-link" href="/th/iceberg/">ดูรายละเอียดแบรนด์ ICEBERG</a>
      </article>
    </div>
  </section>

  <!-- INTERACTIVE ICE FINDER -->
  <section class="section section--surface" id="ice-finder">
    <div class="container">
      <div class="ice-finder" data-reveal>
        <div class="ice-finder__header">
          <p class="eyebrow" lang="en" style="color: var(--color-cyan-bright);">INTERACTIVE ICE FINDER</p>
          <h3>ค้นหาทรงน้ำแข็งที่เข้ากับเมนูเครื่องดื่มของคุณ</h3>
          <p>คลิกเลือกประเภทเครื่องดื่มหรือสไตล์ร้าน เพื่อดูคำแนะนำทรงน้ำแข็ง ขนาด และคุณสมบัติที่เหมาะสมที่สุด</p>
        </div>

        <div class="drink-chip-list" id="drinkChipContainer">
          <button type="button" class="drink-chip active" data-product="ball">
            🥃 On the Rocks & Spirits
          </button>
          <button type="button" class="drink-chip" data-product="cube">
            🍸 Craft Cocktails & Negroni
          </button>
          <button type="button" class="drink-chip" data-product="stick">
            🍹 Highball & Long Drinks
          </button>
          <button type="button" class="drink-chip" data-product="shaker">
            🧊 Cocktail Shaking & Mixing
          </button>
          <button type="button" class="drink-chip" data-product="tube">
            ☕ Cafe, Cold Brew & Daily
          </button>
        </div>

        <div class="finder-result-panel" id="finderResultPanel">
          <div class="finder-result__img-box">
            <img id="finderImg" src="/images/products/crystal-clear-ice-ball.jpg" alt="Crystal Clear Ice Ball" />
          </div>
          <div class="finder-result__details">
            <h4 id="finderBrand">ICEBERG PREMIUM</h4>
            <h3 id="finderTitle">Crystal Clear Ice Ball</h3>
            <p id="finderDesc">
              น้ำแข็งทรงกลมใสบริสุทธิ์ สัดส่วนสมบูรณ์แบบสำหรับแก้ว Rock ช่วยลดพื้นที่สัมผัสกับของเหลว ทำให้อัตราการละลายช้าที่สุด คงรสชาติวิสกี้และสปิริตชั้นเลิศได้ยาวนาน
            </p>
            <div class="finder-specs-grid">
              <div class="finder-spec-item">
                <small>ขนาดก้อน</small>
                <strong id="finderSize">เส้นผ่านศูนย์กลาง 55 มม. / 60 มม.</strong>
              </div>
              <div class="finder-spec-item">
                <small>อัตราการละลาย</small>
                <strong id="finderMelt" style="color: var(--color-cyan-bright);">ละลายช้าที่สุด (Ultra Slow)</strong>
              </div>
              <div class="finder-spec-item">
                <small>แก้วที่แนะนำ</small>
                <strong id="finderGlass">Rock Glass / Old Fashioned</strong>
              </div>
              <div class="finder-spec-item">
                <small>เหมาะสำหรับ</small>
                <strong id="finderFit">Whiskey, Bourbon, Negroni, Old Fashioned</strong>
              </div>
            </div>
            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
              <a id="finderLink" class="button" href="/th/products/crystal-clear-ice-ball/">ดูรายละเอียดสินค้า</a>
              <a class="button button--secondary" style="border-color: rgba(255,255,255,0.3); color: #fff;" href="/th/request-a-quote/">ขอใบเสนอราคาน้ำแข็งทรงนี้</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- INTERACTIVE ICE REQUIREMENT CALCULATOR -->
  <section class="section" id="calculator">
    <div class="container">
      <div class="ice-calculator" data-reveal>
        <div class="calc-grid">
          <div class="calc-form">
            <div>
              <p class="eyebrow" lang="en">ESTIMATE REQUIREMENT</p>
              <h2 style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); margin-bottom: 0.5rem;">เครื่องคำนวณปริมาณน้ำแข็งสำหรับธุรกิจ</h2>
              <p style="color: var(--color-muted); margin: 0;">ประเมินปริมาณน้ำแข็งที่ต้องใช้ต่อวันเพื่อวางแผนการสั่งซื้อและรอบจัดส่ง</p>
            </div>

            <div class="calc-group">
              <label>1. เลือกประเภทธุรกิจของคุณ</label>
              <div class="calc-type-selector" id="calcTypeSelector">
                <button type="button" class="calc-type-btn active" data-type="cafe" data-factor="0.18">
                  ☕ ร้านกาแฟ / คาเฟ่
                </button>
                <button type="button" class="calc-type-btn" data-type="bar" data-factor="0.25">
                  🍸 บาร์ / ผับ / ค็อกเทล
                </button>
                <button type="button" class="calc-type-btn" data-type="restaurant" data-factor="0.3">
                  🍽️ ร้านอาหาร / บุฟเฟต์
                </button>
                <button type="button" class="calc-type-btn" data-type="event" data-factor="0.35">
                  🎪 อีเวนต์ / จัดเลี้ยง
                </button>
              </div>
            </div>

            <div class="calc-group">
              <div class="calc-range-header">
                <label for="drinksSlider" style="margin-bottom: 0;">2. จำนวนเสิร์ฟเครื่องดื่มโดยประมาณ (แก้ว/วัน)</label>
                <span class="calc-range-value" id="drinksValueDisplay">200 แก้ว</span>
              </div>
              <input type="range" id="drinksSlider" class="calc-slider" min="30" max="1000" step="10" value="200" />
            </div>
          </div>

          <div class="calc-result-card">
            <h4>ผลการประเมินปริมาณน้ำแข็ง</h4>
            <div class="calc-result-number">
              <span id="calcKgResult">36</span> <span>กก. / วัน</span>
            </div>
            <div class="calc-result-meta">
              <p id="calcRecommendation" style="margin: 0 0 0.5rem 0;">
                💡 แนะนำ: <strong>Super Ice หลอดเล็ก</strong> ประมาณ 2-3 กระสอบ/วัน
              </p>
              <p style="margin: 0; color: #94a3b8; font-size: 0.8125rem;">
                *ค่าคำนวณเบื้องต้น รวมเผื่ออัตราการละลายในภาชนะเก็บน้ำแข็งมาตรฐาน
              </p>
            </div>
            <a class="button" id="calcQuoteBtn" href="/th/request-a-quote/">
              ขอใบเสนอราคาตามปริมาณนี้
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRODUCTION PROCESS -->
  <section id="production-process" class="production-showcase" aria-labelledby="production-showcase-title">
    <div class="production-showcase__hero">
      <img
        class="production-showcase__image"
        src="/images/process-factory-hero.png"
        alt="ภาพจำลองถุงน้ำแข็งใสสะอาดเคลื่อนผ่านสายพานในโรงงานผลิต"
        width="1870"
        height="841"
        loading="lazy"
        decoding="async"
      />

      <div class="container production-showcase__hero-inner">
        <div class="production-showcase__copy" data-reveal>
          <p class="eyebrow" lang="en">PURE &amp; PRECISE PROCESS</p>
          <h2 id="production-showcase-title">กระบวนการผลิต<br />มาตรฐานสากลทุกขั้นตอน</h2>
          <p>
            ใส่ใจในทุกขั้นตอนการผลิต เพื่อมอบน้ำแข็งคุณภาพสูง<br class="production-showcase__desktop-break" />
            สะอาด บริสุทธิ์ ปลอดภัย และเชื่อถือได้สำหรับธุรกิจของคุณ
          </p>
          <a class="text-link production-showcase__link" href="/th/production-process/">
            ดูกระบวนการผลิตแบบละเอียด
          </a>
        </div>

        <div class="production-showcase__factory-brand" aria-hidden="true">
          <SiteMark />
        </div>

        <div class="production-showcase__signal production-showcase__signal--snow" aria-hidden="true">
          <i class="ph ph-snowflake"></i>
        </div>
        <div class="production-showcase__signal production-showcase__signal--drop" aria-hidden="true">
          <i class="ph ph-drop"></i>
        </div>
        <div class="production-showcase__signal production-showcase__signal--shield" aria-hidden="true">
          <i class="ph ph-shield-check"></i>
        </div>
      </div>
    </div>

    <div class="container production-showcase__process" data-reveal>
      <ol class="production-showcase__steps" aria-label="5 ขั้นตอนในกระบวนการผลิตน้ำแข็ง">
        {
          process.map(({ number, icon, name, detail }, index) => (
            <li class="production-step">
              <div class="production-step__rail" aria-hidden="true">
                <span>{number}</span>
              </div>
              <article class="production-step__card">
                <i class:list={["ph", icon, "production-step__icon"]} aria-hidden="true"></i>
                <h3>{name}</h3>
                <span class="production-step__accent" aria-hidden="true"></span>
                <p>{detail}</p>
              </article>
              {index < process.length - 1 && (
                <span class="production-step__next" aria-hidden="true">
                  <i class="ph ph-caret-right"></i>
                </span>
              )}
            </li>
          ))
        }
      </ol>

      <div class="production-showcase__assurances" aria-label="คุณภาพและการบริการที่มั่นใจได้">
        {
          processAssurances.map(({ icon, title, detail }) => (
            <div class="process-assurance">
              <i class:list={["ph", icon]} aria-hidden="true"></i>
              <div>
                <strong>{title}</strong>
                <span>{detail}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- TRUST & CERTIFICATIONS -->
  <section class="section section--dark">
    <div class="container section-heading" data-reveal>
      <div>
        <p class="eyebrow" lang="en" style="color: var(--color-cyan-bright);">STANDARDS & ASSURANCE</p>
        <h2 style="color: var(--color-white);">มาตรฐานและการรับรองระดับประเทศ</h2>
      </div>
      <p style="color: #cbd5e1;">สร้างความมั่นใจสูงสุดให้กับลูกค้าของคุณ ด้วยน้ำแข็งที่ผ่านการตรวจสอบสุขอนามัยและเอกสารรับรองอย่างเป็นทางการ</p>
    </div>

    <div class="container cert-grid" data-reveal>
      <div class="cert-card" style="background: var(--color-obsidian-card); border-color: rgba(255,255,255,0.1);">
        <span class="cert-badge">อย. กระทรวงสาธารณสุข</span>
        <h3 style="color: var(--color-white);">ใบอนุญาตผลิตอาหาร</h3>
        <p style="color: #94a3b8;">เลขที่ใบอนุญาต 10-1-16557 ควบคุมสถานที่ผลิต เครื่องจักร และสุขอนามัยพนักงานตามเกณฑ์ข้อกำหนดของสำนักงานคณะกรรมการอาหารและยา</p>
      </div>

      <div class="cert-card" style="background: var(--color-obsidian-card); border-color: rgba(255,255,255,0.1);">
        <span class="cert-badge">มาตรฐาน GMP 420</span>
        <h3 style="color: var(--color-white);">รับรองโดย สถาบัน วว. (TISTR)</h3>
        <p style="color: #94a3b8;">ผ่านการตรวจประเมินตามมาตรฐานสุขลักษณะการผลิตที่ดี (Good Manufacturing Practice) มีระบบควบคุมคุณภาพน้ำและการฆ่าเชื้ออย่างเข้มงวด</p>
      </div>

      <div class="cert-card" style="background: var(--color-obsidian-card); border-color: rgba(255,255,255,0.1);">
        <span class="cert-badge">Cold-Chain 24/7</span>
        <h3 style="color: var(--color-white);">ขนส่งควบคุมอุณหภูมิ</h3>
        <p style="color: #94a3b8;">กองรถส่งห้องเย็นมากกว่า 50 คัน กระจายทั่วกรุงเทพฯ และปริมณฑล มั่นใจได้ว่าน้ำแข็งจะถึงมือในสภาพแห้ง คม ไม่ละลายเป็นก้อนติดกัน</p>
      </div>
    </div>
  </section>

  <!-- SOLUTIONS BY BUSINESS -->
  <section class="section" id="solutions">
    <div class="container section-heading" data-reveal>
      <div>
        <p class="eyebrow" lang="en">SOLUTIONS BY BUSINESS</p>
        <h2>โซลูชันน้ำแข็งเฉพาะทางตามประเภทธุรกิจ</h2>
      </div>
      <p>เลือกตามโจทย์ของธุรกิจคุณ เพื่อเชื่อมต่อไปยังสินค้า ขนาดบรรจุ และแนวทางการวางแผนที่ตอบโจทย์</p>
    </div>

    <div class="container solution-list">
      {
        solutions.map((solution, index) => (
          <a href={`/th/solutions/${solution.id}/`} data-reveal>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{solution.data.title}</strong>
            <small>{solution.data.description}</small>
            <i aria-hidden="true">→</i>
          </a>
        ))
      }
    </div>
  </section>

  <!-- DELIVERY AREAS -->
  <section class="section section--surface delivery-feature">
    <div class="container delivery-feature__grid">
      <div class="delivery-map" aria-hidden="true" data-reveal>
        <span class="delivery-map__zone zone-a"></span>
        <span class="delivery-map__zone zone-b"></span>
        <span class="delivery-map__zone zone-c"></span>
        <span class="delivery-map__route"></span>
        <strong>GREATER BANGKOK</strong>
        <small>ครอบคลุมกรุงเทพฯ และปริมณฑล ตลอด 24 ชม.</small>
      </div>
      <div data-reveal>
        <p class="eyebrow" lang="en">DELIVERY COORDINATION</p>
        <h2>ตรวจสอบพื้นที่และวางแผนรอบจัดส่งประจำ</h2>
        <p class="lead">
          ศูนย์กระจายสินค้าครอบคลุมโซนนวมินทร์ มีนบุรี รามอินทรา ลาดพร้าว บางกะปิ ร่มเกล้า ลาดกระบัง และพื้นที่ปริมณฑล พร้อมส่งมอบตรงเวลาตามรอบการเปิดร้านของคุณ
        </p>
        <a class="button" href="/th/delivery-areas/" data-track="check_delivery_area">ดูพื้นที่จัดส่งทั้งหมด</a>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION -->
  <section class="section faq-section">
    <div class="container faq-section__grid">
      <div data-reveal>
        <p class="eyebrow" lang="en">FAQ</p>
        <h2>คำถามที่พบบ่อยก่อนเริ่มสั่งซื้อ</h2>
        <p style="color: var(--color-muted); margin-top: 1rem;">
          หากมีข้อสงสัยเพิ่มเติม ทีมงานพร้อมให้คำปรึกษาและตอบคำถามตลอด 24 ชั่วโมง
        </p>
      </div>
      <div class="faq-list">
        {
          faq.map((item) => (
            <details data-reveal>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section final-cta">
    <div class="container final-cta__grid">
      <div data-reveal>
        <p class="eyebrow" lang="en">START A CONVERSATION</p>
        <h2>ปรึกษาทีมงานเพื่อรับใบเสนอราคาพิเศษสำหรับธุรกิจของคุณ</h2>
        <p>แจ้งประเภทธุรกิจ พื้นที่จัดส่ง และปริมาณที่ต้องการ เพื่อให้เราประเมินแพ็กเกจที่คุ้มค่าที่สุด</p>
      </div>
      <div class="final-cta__actions" data-reveal>
        <a class="button" href="/th/request-a-quote/">ขอใบเสนอราคาออนไลน์</a>
        <ContactActions compact />
      </div>
    </div>
  </section>

  <!-- CLIENT-SIDE INTERACTION SCRIPT -->
  <script is:inline src="/scripts/home-interactive.js"></script>
</BaseLayout>
