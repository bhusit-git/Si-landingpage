---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PageHero from "../../components/PageHero.astro";
import ProductVisual from "../../components/ProductVisual.astro";
import ContactActions from "../../components/ContactActions.astro";
import site from "../../config/site.js";
import { brandSchema, breadcrumbSchema, organizationSchema, webPageSchema } from "../../lib/seo";

const title = "ICEBERG น้ำแข็งพรีเมียมสำหรับเครื่องดื่ม";
const description =
  "ICEBERG แบรนด์น้ำแข็งพรีเมียมจาก Super Ice Group สำหรับบาร์ คาเฟ่ ร้านอาหาร และโรงแรม ยกระดับทุกแก้วด้วยความใสบริสุทธิ์และรูปทรงมาตรฐาน";
const path = "/th/iceberg/";
const breadcrumbs = [
  { label: "หน้าแรก", href: "/th/" },
  { label: "ICEBERG", href: path },
];
const productOrder = [
  "crystal-clear-ice-ball",
  "crystal-clear-ice-cube",
  "crystal-clear-ice-stick",
  "crystal-clear-ice-shaker",
];
const getOrder = (id: string) => {
  const idx = productOrder.indexOf(id);
  return idx === -1 ? 99 : idx;
};

const rawProducts = await getCollection(
  "products",
  ({ data }) =>
    data.brand === "ICEBERG" && !data.draft && (!site.productionReady || data.copyApproved),
);
const products = rawProducts.sort((a, b) => getOrder(a.id) - getOrder(b.id));
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  schemas={[
    organizationSchema(),
    brandSchema({ name: "ICEBERG", description, path }),
    webPageSchema({ title, description, path }),
    breadcrumbSchema(breadcrumbs),
  ]}
  bodyClass="iceberg-page"
>
  <Breadcrumbs items={breadcrumbs} />
  <PageHero
    eyebrow="ICEBERG / PREMIUM RANGE"
    title="ICEBERG รูปทรงที่ชัดเจนสำหรับงานเครื่องดื่ม"
    lead="แบรนด์น้ำแข็งพรีเมียมเพื่อธุรกิจเครื่องดื่ม บาร์ ร้านอาหาร และโรงแรม ยกระดับทุกแก้วด้วยความใสบริสุทธิ์และรูปทรงที่ประณีต สวยงาม สม่ำเสมอ"
    dark
    brand="ICEBERG"
  />

  <section class="section section--dark iceberg-values">
    <div class="container iceberg-values__grid">
      <div data-reveal><span>01</span><h2>รูปทรง</h2><p>มีรูปทรงหลากหลายทั้ง Ball, Cube, Shaker และ Stick เพื่อให้เหมาะกับแก้วและเมนูเครื่องดื่มทุกรูปแบบ</p></div>
      <div data-reveal><span>02</span><h2>ความสม่ำเสมอ</h2><p>ผลิตด้วยกระบวนการพิเศษ มอบก้อนน้ำแข็งที่ใสสะอาด ละลายช้า ไม่ทำให้เครื่องดื่มเสียรสชาติ</p></div>
      <div data-reveal><span>03</span><h2>การใช้งาน</h2><p>ออกแบบเพื่อบาร์เทนเดอร์และร้านอาหารระดับพรีเมียม พร้อมให้คำปรึกษาและจัดส่งอย่างสม่ำเสมอ</p></div>
    </div>
  </section>

  <section class="section product-family iceberg-products">
    <div class="container product-family__heading" data-reveal>
      <div><p class="eyebrow" lang="en">CRYSTAL CLEAR RANGE</p><h2>ผลิตภัณฑ์น้ำแข็งพรีเมียม ICEBERG</h2></div>
    </div>
    <div class="container product-listing">
      {
        products.map((product) => (
          <article class="product-card product-card--dark" data-reveal>
            <ProductVisual kind={product.id} label={product.data.title} dark />
            <div class="product-card__copy">
              <p class="eyebrow" lang="en">{product.data.brand}</p>
              <h3>{product.data.title}</h3>
              <p>{product.data.summary}</p>
              <a class="text-link" href={`/th/products/${product.id}/`}>ดูรายละเอียดสินค้า</a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--surface iceberg-process">
    <div class="container iceberg-process__grid">
      <div data-reveal style="border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--color-line); box-shadow: 0 15px 35px -10px rgba(0, 176, 240, 0.2);">
        <img src="/images/iceberg-hero.jpg" alt="ICEBERG Crystal Clear Cocktail Ice" style="width: 100%; height: 100%; object-fit: cover;" />
      </div>
      <div data-reveal>
        <p class="eyebrow" lang="en">PRODUCTION CONTEXT</p>
        <h2>มาตรฐานความสะอาดด้วยระบบ Reverse Osmosis (RO) & 48H Slow Freeze</h2>
        <p class="lead">ควบคุมความสะอาดและความบริสุทธิ์ในทุกขั้นตอน ตั้งแต่การกรองน้ำด้วยระบบ Reverse Osmosis (RO) ไปจนถึงการขึ้นรูปและการจัดเก็บที่ได้มาตรฐานระดับสากล ปราศจากฟองอากาศ ละลายช้า ให้ความเย็นจัดสม่ำเสมอ</p>
        <a class="text-link" href="/th/quality-and-standards/">ดูแนวทางคุณภาพและมาตรฐาน</a>
      </div>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container final-cta__grid">
      <div><p class="eyebrow" lang="en">ICEBERG ENQUIRY</p><h2>เลือกทรงน้ำแข็งให้เหมาะกับเมนู</h2><p>แจ้งรูปแบบแก้ว ประเภทเครื่องดื่ม ปริมาณ พื้นที่ และวันที่ใช้งาน เพื่อให้ทีมงานช่วยแนะนำตัวเลือกที่ดีที่สุดสำหรับคุณ</p></div>
      <div class="final-cta__actions">
        <a class="button" href={site.brandContacts.iceberg.lineUrl} data-track="click_line" data-channel="iceberg-line">LINE {site.brandContacts.iceberg.lineId}</a>
        <ContactActions compact />
      </div>
    </div>
  </section>
</BaseLayout>
