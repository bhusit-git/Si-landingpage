---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PageHero from "../../components/PageHero.astro";
import ProductVisual from "../../components/ProductVisual.astro";
import ContactActions from "../../components/ContactActions.astro";
import site from "../../config/site.js";
import { brandSchema, breadcrumbSchema, organizationSchema, webPageSchema } from "../../lib/seo";

const title = "ICEBERG น้ำแข็งพรีเมียมสำหรับเครื่องดื่ม";
const description =
  "ICEBERG คือแบรนด์น้ำแข็งพรีเมียมของ Super Ice Group สำหรับร้านอาหาร คาเฟ่ บาร์ และ hospitality โดยแยกข้อมูลสินค้าออกจาก Super Ice อย่างชัดเจน";
const path = "/th/iceberg/";
const breadcrumbs = [
  { label: "หน้าแรก", href: "/th/" },
  { label: "ICEBERG", href: path },
];
const products = await getCollection(
  "products",
  ({ data }) =>
    data.brand === "ICEBERG" && !data.draft && (!site.productionReady || data.copyApproved),
);
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  schemas={[
    organizationSchema(),
    brandSchema({ name: "ICEBERG", description, path }),
    webPageSchema({ title, description, path }),
    breadcrumbSchema(breadcrumbs),
  ]}
  bodyClass="iceberg-page"
>
  <Breadcrumbs items={breadcrumbs} />
  <PageHero
    eyebrow="ICEBERG / PREMIUM RANGE"
    title="ICEBERG รูปทรงที่ชัดเจนสำหรับงานเครื่องดื่ม"
    lead="แบรนด์น้ำแข็งพรีเมียมภายใต้ Super Ice Group สำหรับงานที่ให้ความสำคัญกับรูปทรง การนำเสนอ และความสม่ำเสมอ"
    dark
    brand="ICEBERG"
  />

  <section class="section section--dark iceberg-values">
    <div class="container iceberg-values__grid">
      <div data-reveal><span>01</span><h2>รูปทรง</h2><p>ข้อมูลสินค้าแยกตาม Ball, Cube, Shaker และ Stick โดยไม่เติมสเปกที่เอกสารไม่รองรับ</p></div>
      <div data-reveal><span>02</span><h2>ความสม่ำเสมอ</h2><p>สื่อสารเฉพาะคุณลักษณะที่มาจากเอกสารต้นทาง และพัก claim ที่ต้องมีหลักฐานเปรียบเทียบ</p></div>
      <div data-reveal><span>03</span><h2>การใช้งาน</h2><p>เชื่อมแต่ละรูปทรงกับประเภทธุรกิจและเครื่องดื่ม ก่อนให้ทีมงานยืนยันรายละเอียด</p></div>
    </div>
  </section>

  <section class="section product-family iceberg-products">
    <div class="container product-family__heading" data-reveal>
      <div><p class="eyebrow" lang="en">CRYSTAL CLEAR RANGE</p><h2>รูปทรงจากข้อมูลผลิตภัณฑ์ต้นทาง</h2></div>
    </div>
    <div class="container product-listing">
      {
        products.map((product) => (
          <article class="product-card product-card--dark" data-reveal>
            <ProductVisual kind={product.id} label={product.data.title} dark />
            <div class="product-card__copy">
              <p class="eyebrow" lang="en">{product.data.brand}</p>
              <h3>{product.data.title}</h3>
              <p>{product.data.summary}</p>
              <a class="text-link" href={`/th/products/${product.id}/`}>ดูรายละเอียดสินค้า</a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--surface iceberg-process">
    <div class="container iceberg-process__grid">
      <div class="iceberg-process__art" aria-hidden="true" data-reveal><span>RO</span><i></i><strong>QUALITY CONTROL</strong></div>
      <div data-reveal><p class="eyebrow" lang="en">PRODUCTION CONTEXT</p><h2>อธิบายกระบวนการโดยไม่ใช้ผลตรวจเกินขอบเขต</h2><p class="lead">ข้อมูลต้นทางกล่าวถึง Reverse Osmosis และการควบคุมกระบวนการ แต่เว็บไซต์จะไม่เผยแพร่รายงานแล็บที่มีข้อจำกัดด้านโฆษณาหรือเอกสารที่ยังไม่ได้รับอนุญาต</p><a class="text-link" href="/th/quality-and-standards/">ดูแนวทางคุณภาพ</a></div>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container final-cta__grid">
      <div><p class="eyebrow" lang="en">ICEBERG ENQUIRY</p><h2>เลือกทรงน้ำแข็งให้เหมาะกับเมนู</h2><p>แจ้งรูปแบบแก้ว ประเภทเครื่องดื่ม ปริมาณ พื้นที่ และวันที่ใช้งาน เพื่อให้ทีมงานตรวจสอบตัวเลือก</p></div>
      <div class="final-cta__actions">
        <a class="button" href={`tel:${site.brandContacts.iceberg.phone}`} data-track="click_phone" data-channel="iceberg-phone">โทร {site.brandContacts.iceberg.phoneDisplay}</a>
        <a class="button button--secondary" href={site.brandContacts.iceberg.lineUrl} data-track="click_line" data-channel="iceberg-line">LINE {site.brandContacts.iceberg.lineId}</a>
        <ContactActions compact />
      </div>
    </div>
  </section>
</BaseLayout>
